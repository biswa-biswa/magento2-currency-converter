                <select id="cc-period">
                    <option value="30"><?= $block->escapeHtml(__('30 days')) ?></option>
                    <option value="90"><?= $block->escapeHtml(__('90 days')) ?></option>
                    <option value="180"><?= $block->escapeHtml(__('180 days')) ?></option>
                    <option value="365"><?= $block->escapeHtml(__('1 year')) ?></option>
                </select>
            </label>
        </div>
        <div class="chart-wrap">
