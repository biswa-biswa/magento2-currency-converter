<?php
/** @var \Totp\CurrencyConverter\Block\Converter $block */
?>
<div class="currency-converter"
     data-mage-init='{"Totp_CurrencyConverter/js/converter": {
        "currenciesUrl": "<?= $block->escapeUrl($block->getCurrenciesUrl()) ?>",
        "rateUrl": "<?= $block->escapeUrl($block->getRateUrl()) ?>",
        "historyUrl": "<?= $block->escapeUrl($block->getHistoryUrl()) ?>"
     }}'>
    <div class="converter-heading">
        <h1><?= $block->escapeHtml(__('Currency Exchange Converter')) ?></h1>
        <p><?= $block->escapeHtml(__('Compare reference exchange rates and explore historical movement.')) ?></p>
    </div>

    <div class="converter-panel">
        <div class="converter-fields">
            <div class="field amount-field">
                <label for="cc-amount"><?= $block->escapeHtml(__('Amount')) ?></label>
                <input id="cc-amount" type="number" min="0" step="any" value="1">
            </div>
            <div class="field">
                <label for="cc-from"><?= $block->escapeHtml(__('From')) ?></label>
                <select id="cc-from"><option value="USD">USD</option></select>
            </div>
            <button type="button" class="cc-swap" aria-label="<?= $block->escapeHtmlAttr(__('Swap currencies')) ?>" title="<?= $block->escapeHtmlAttr(__('Swap currencies')) ?>">⇄</button>
            <div class="field">
                <label for="cc-to"><?= $block->escapeHtml(__('To')) ?></label>
                <select id="cc-to"><option value="EUR">EUR</option></select>
            </div>
        </div>

        <div class="converter-result" aria-live="polite">
            <div class="cc-result-label"><?= $block->escapeHtml(__('Converted amount')) ?></div>
            <div class="cc-result-value" id="cc-result">—</div>
            <div class="cc-rate" id="cc-rate"><?= $block->escapeHtml(__('Loading exchange rate…')) ?></div>
            <div class="cc-date" id="cc-date"></div>
        </div>
        <div class="cc-error" id="cc-error" role="alert"></div>
    </div>

